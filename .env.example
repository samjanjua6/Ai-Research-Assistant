# ── LLM ──────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ── Database ──────────────────────────────────────────────────────
POSTGRES_USER=research
POSTGRES_PASSWORD=research_pass
POSTGRES_DB=research_helper
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Assembled automatically by config.py — you can override here too
# DATABASE_URL=postgresql+asyncpg://research:research_pass@localhost:5432/research_helper

# ── App ───────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── CORS (comma-separated origins) ───────────────────────────────
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:5500
